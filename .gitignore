# Python and Node local environments
.venv/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.tmp-*-tests-*/
build/
dist/
dist-installer/

# Local runtime data and generated indexes
artifacts/data/
artifacts/indexes/
artifacts/evaluations/
artifacts/models/*
!artifacts/models/README.md
!artifacts/models/office-student-int8/
!artifacts/models/office-student-int8/0.1.0/
!artifacts/models/office-student-int8/0.1.0/manifest.example.json

# Large model weights and local secrets
*.gguf
*.safetensors
*.bin
.env
.env.*
!.env.example

# Editor and operating-system files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Capacitor native build outputs
android/.gradle/
android/build/
android/app/build/
android/.idea/
ios/App/Pods/
ios/App/build/
ios/DerivedData/

# Release-ledger working files and generated previews (keep the workbook itself)
.release-work/
outputs/**/*.png
outputs/**/*.inspect.ndjson
outputs/edge-office-release-ledger/EdgeOffice-版本发布台账.xlsx
outputs/**/~$*.xlsx

# Native signing material and machine-specific configuration
android/local.properties
android/**/*.keystore
android/**/*.jks
ios/**/*.mobileprovision
ios/**/*.p12
*.pem
