# Python and Node local environments
.venv/
node_modules/
public/vendor/
public/mobile-document-parser.js
__pycache__/
*.py[cod]
.pytest_cache/
.tmp-*-tests-*/
.tmp-ui-check/
build/
dist/
dist-installer/
dist-mobile/

# Local runtime data and generated indexes
artifacts/data/
artifacts/indexes/
artifacts/evaluations/
artifacts/models/*
!artifacts/models/README.md
!artifacts/models/office-student-int8/
!artifacts/models/office-student-int8/0.1.0/
!artifacts/models/office-student-int8/0.1.0/manifest.example.json

# Large model weights and local secrets
*.gguf
*.safetensors
*.bin
*.db
*.sqlite
*.sqlite3
*.gguf.part*
*.pt
*.pth
*.ckpt
*.key
.env
.env.*
!.env.example

# Editor and operating-system files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Capacitor native build outputs
android/.gradle/
android/build/
android/app/build/
android/.idea/
ios/App/Pods/
ios/App/build/
ios/DerivedData/

# Release-ledger working files and generated previews (keep the workbook itself)
.release-work/
outputs/**/*.png
outputs/**/*.inspect.ndjson
outputs/edge-office-release-ledger/EdgeOffice-版本发布台账.xlsx
outputs/**/~$*.xlsx
outputs/*
!outputs/edge-office-release-ledger/
public/chongqing-8d.html

# Native signing material and machine-specific configuration
android/local.properties
android/**/*.keystore
android/**/*.jks
ios/**/*.mobileprovision
ios/**/*.p12
*.pem

# Vendor only the native build inputs; never vocabulary models or upstream demos.
android/third_party/llama.cpp/*
!android/third_party/llama.cpp/CMakeLists.txt
!android/third_party/llama.cpp/LICENSE
!android/third_party/llama.cpp/AUTHORS
!android/third_party/llama.cpp/cmake/
!android/third_party/llama.cpp/include/
!android/third_party/llama.cpp/src/
!android/third_party/llama.cpp/ggml/
!android/third_party/llama.cpp/vendor/
